# Runtime
APP_ENV=development
PROJECT_NAME=License Plate Recognition API
API_VERSION=1.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local ports
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local filesystem storage
UPLOAD_DIR=uploads
ANNOTATED_DIR=uploads/annotated
PLATE_CROP_DIR=uploads/plates
ENHANCED_DIR=uploads/enhanced
MAX_UPLOAD_SIZE_BYTES=10485760

# Database and async services
POSTGRES_DB=lpr
POSTGRES_USER=lpr_user
POSTGRES_PASSWORD=lpr_password
DATABASE_URL=postgresql://lpr_user:lpr_password@postgres:5432/lpr
REDIS_URL=redis://redis:6379/0

# Object storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lpr-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI service
AI_SERVICE_URL=http://ai-service:9000
YOLO_MODEL_PATH=models/license_plate_detector.pt
DETECTION_CONF_THRESHOLD=0.25
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_NMS_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=960
YOLO_MAX_DETECTIONS=20
YOLO_CLASSES=
YOLO_CLASS_NAMES=license_plate,plate,number_plate,licence_plate
YOLO_AGNOSTIC_NMS=false
YOLO_MIN_BOX_WIDTH=12
YOLO_MIN_BOX_HEIGHT=6
YOLO_MIN_BOX_AREA_RATIO=0.00005
YOLO_MAX_BOX_AREA_RATIO=0.20
YOLO_MIN_ASPECT_RATIO=1.8
YOLO_MAX_ASPECT_RATIO=5.5
YOLO_CROP_PADDING_X=0.06
YOLO_CROP_PADDING_Y=0.16
YOLO_ALLOW_GENERIC_FALLBACK=false
FALLBACK_PREPROCESSING_VARIANTS=original,contrast_clahe,low_light_gamma,sharpened
FALLBACK_MAX_IMAGE_SIDE=1280
FALLBACK_MAX_CONTOURS=40
FALLBACK_MAX_OCR_CANDIDATES=4
FALLBACK_MAX_DETECTIONS=2
FALLBACK_ENABLE_UPSCALE=false
FALLBACK_ENABLE_WHOLE_IMAGE_PLATE_CANDIDATE=true

# Image enhancement
REAL_ESRGAN_MODEL_PATH=weights/RealESRGAN_x4plus.pth
REAL_ESRGAN_SCALE=4
REAL_ESRGAN_TILE=128
REAL_ESRGAN_HALF=false

# OCR
OCR_LANGUAGES=en
OCR_GPU=false
OCR_PREPROCESSING_STRATEGIES=original_resized,clahe,adaptive_threshold
OCR_MAX_VARIANTS=3
OCR_MIN_VARIANTS_BEFORE_EARLY_EXIT=1
OCR_EARLY_EXIT_CONFIDENCE=0.82
OCR_TARGET_HEIGHT=96
OCR_MAX_UPSCALE=4
OCR_MAX_IMAGE_WIDTH=768
